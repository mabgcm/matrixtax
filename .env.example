# Copy to .env for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# --- Contact form email delivery (https://resend.com) -------------------
# Without RESEND_API_KEY the form logs submissions locally (dev) and returns
# "temporarily unavailable" in production builds.
RESEND_API_KEY=
# Inbox that receives enquiries. Defaults to the address in src/config/site.ts.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Matrix Tax Website <website@matrixtaxsolutions.ca>"
CONTACT_FROM_EMAIL=

# --- Cloudflare Turnstile (optional, recommended spam protection) -------
# Both keys must be set to enable the widget + server-side verification.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Meta Pixel ----------------------------------------------------------
# Loaded only after the visitor accepts advertising cookies. Leave empty to disable.
PUBLIC_META_PIXEL_ID=1523587012050536
