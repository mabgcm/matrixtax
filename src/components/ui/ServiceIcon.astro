---
import { BuildingComplex, Calculator, ReceiptText, ShieldCheck } from '@lucide/astro';

interface Props {
  name: 'receipt' | 'calculator' | 'building' | 'shield';
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const icons = {
  receipt: ReceiptText,
  calculator: Calculator,
  building: BuildingComplex,
  shield: ShieldCheck,
};
const Icon = icons[name];
---

<Icon size={size} class={className} />
