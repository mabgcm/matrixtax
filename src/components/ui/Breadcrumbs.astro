---
import { ChevronRight } from '@lucide/astro';
import type { Crumb } from '@/lib/seo';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav aria-label="Breadcrumb" lang="en">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500">
    {crumbs.map((crumb, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && <ChevronRight size={14} class="text-slate-400" />}
        {index === last ? (
          <span aria-current="page" class="line-clamp-1 font-medium text-slate-700">
            {crumb.name}
          </span>
        ) : (
          <a href={crumb.path} class="transition-colors hover:text-brand-700">
            {crumb.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
