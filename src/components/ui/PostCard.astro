---
import { Image } from 'astro:assets';
import { formatDate, postUi, readingMinutes, type Post } from '@/lib/content';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const { title, description, heroImage, pubDate, lang } = post.data;
const Heading = headingLevel;
const t = postUi(lang);
---

<article
  class="group card relative flex h-full flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift"
  lang={lang}
>
  <div class="aspect-video overflow-hidden bg-slate-100">
    <Image
      src={heroImage}
      alt=""
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 30rem, (min-width: 768px) 45vw, 92vw"
      class="size-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{t.minRead(readingMinutes(post.body))}</span>
      {lang !== 'en' && (
        <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">
          {t.language}
        </span>
      )}
    </p>
    <Heading class="mt-3 text-xl leading-snug">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 after:rounded-3xl">
        {title}
      </a>
    </Heading>
    <p class="mt-3 line-clamp-3 leading-relaxed">{description}</p>
  </div>
</article>
