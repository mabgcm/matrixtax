---
import { getCollection } from 'astro:content';
import { ArrowUpRight, Mail, MapPin, Phone } from '@lucide/astro';
import Logo from '@/components/brand/Logo.astro';
import { site, usefulLinks } from '@/config/site';
import { PUBLIC_META_PIXEL_ID } from 'astro:env/client';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();

const companyLinks = [
  { label: 'About us', href: '/#about' },
  { label: 'How we work', href: '/#process' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-brand-950 text-slate-300">
  <div class="container-page py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <Logo variant="dark" />
        <p class="mt-6 max-w-sm leading-relaxed text-slate-400">
          Personalized tax, accounting and business advisory services for individuals and small
          businesses. Let us handle your numbers, so you can focus on what matters most.
        </p>
        <a href="/contact" class="btn btn-on-dark mt-8">
          Book a free consultation
        </a>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">
            Services
          </h2>
          <ul class="mt-5 space-y-3">
            {services.map((service) => (
              <li>
                <a href={`/services/${service.id}`} class="transition-colors hover:text-white">
                  {service.data.shortTitle}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Company</h2>
          <ul class="mt-5 space-y-3">
            {companyLinks.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <h2 class="font-display text-sm font-bold tracking-wide text-white uppercase">Contact</h2>
          <ul class="mt-5 space-y-4">
            <li class="flex gap-3">
              <Phone size={18} class="mt-0.5 shrink-0 text-brand-400" />
              <span class="flex flex-col gap-1">
                <a
                  href={site.links.call}
                  data-track="call"
                  data-track-location="footer"
                  class="transition-colors hover:text-white"
                >
                  {site.phones.primary.display}
                </a>
                <a
                  href={`tel:${site.phones.secondary.e164}`}
                  data-track="call"
                  data-track-location="footer"
                  class="transition-colors hover:text-white"
                >
                  {site.phones.secondary.display}
                </a>
              </span>
            </li>
            <li class="flex gap-3">
              <Mail size={18} class="mt-0.5 shrink-0 text-brand-400" />
              <span class="flex min-w-0 flex-col gap-1">
                <a
                  href={`mailto:${site.emails.primary}`}
                  data-track="email"
                  data-track-location="footer"
                  class="break-all transition-colors hover:text-white"
                >
                  {site.emails.primary}
                </a>
                <a
                  href={`mailto:${site.emails.advisor}`}
                  data-track="email"
                  data-track-location="footer"
                  class="break-all transition-colors hover:text-white"
                >
                  {site.emails.advisor}
                </a>
              </span>
            </li>
            <li class="flex gap-3">
              <MapPin size={18} class="mt-0.5 shrink-0 text-brand-400" />
              <a
                href={site.links.maps}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white"
              >
                {site.address.street}
                <br />
                {`${site.address.city}, ${site.address.region} ${site.address.postalCode}`}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-8">
      <h2 class="sr-only">Useful links</h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-400">
        {usefulLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 transition-colors hover:text-white"
            >
              {link.label}
              <ArrowUpRight size={14} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>
        &copy; {year} {site.legalName} All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="/privacy" class="transition-colors hover:text-white">
          Privacy policy
        </a>
        {PUBLIC_META_PIXEL_ID && (
          <button
            type="button"
            data-consent-open
            class="cursor-pointer transition-colors hover:text-white"
          >
            Cookie preferences
          </button>
        )}
      </div>
    </div>
  </div>
</footer>
