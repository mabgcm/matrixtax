---
import { ArrowRight, Mail, Menu, MessageSquareText, Phone, X } from '@lucide/astro';
import Logo from '@/components/brand/Logo.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { formattedAddress, mainNav, site } from '@/config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  !href.includes('#') && href !== '/' && (path === href || path.startsWith(`${href}/`));

const quickActions = [
  { label: 'Call', href: site.links.call, track: 'call', icon: 'phone' },
  { label: 'Text', href: site.links.sms, track: 'sms', icon: 'sms' },
  { label: 'WhatsApp', href: site.links.whatsapp, track: 'whatsapp', icon: 'whatsapp' },
  { label: 'Email', href: site.links.email, track: 'email', icon: 'mail' },
] as const;
---

<header class="site-header sticky top-0 z-40 bg-white/85 backdrop-blur-xl">
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-6">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="rounded-full px-3.5 py-2 text-[0.95rem] font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={site.links.call}
        data-track="call"
        data-track-location="header"
        class="group hidden items-center gap-3 xl:flex"
      >
        <span class="grid size-10 place-items-center rounded-full bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-100">
          <Phone size={18} />
        </span>
        <span class="flex flex-col leading-tight">
          <span class="text-xs font-medium text-slate-500">Call us</span>
          <span class="font-semibold text-slate-900">{site.phones.primary.display}</span>
        </span>
      </a>
      <a href="/contact" class="btn btn-primary min-h-11 px-5">
        Book a consultation
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={site.links.call}
        data-track="call"
        data-track-location="header"
        class="grid size-11 place-items-center rounded-full bg-brand-50 text-brand-700"
        aria-label={`Call ${site.phones.primary.display}`}
      >
        <Phone size={20} />
      </a>
      <button
        type="button"
        popovertarget="mobile-menu"
        class="grid size-11 place-items-center rounded-full text-slate-900 ring-1 ring-slate-200 ring-inset"
        aria-label="Open menu"
      >
        <Menu size={22} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" popover class="mobile-menu" aria-label="Menu">
  <div class="flex min-h-full flex-col">
    <div class="container-page flex h-[4.5rem] items-center justify-between">
      <Logo />
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="grid size-11 place-items-center rounded-full text-slate-900 ring-1 ring-slate-200 ring-inset"
        aria-label="Close menu"
      >
        <X size={22} />
      </button>
    </div>

    <nav aria-label="Mobile" class="container-page mt-4">
      <ul class="divide-y divide-slate-100">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="flex items-center justify-between py-4 font-display text-2xl font-bold text-slate-900 aria-[current=page]:text-brand-600"
            >
              {item.label}
              <ArrowRight size={22} class="text-slate-300" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="container-page mt-auto pt-8 pb-[calc(2rem+env(safe-area-inset-bottom))]">
      <ul class="grid grid-cols-4 gap-2">
        {quickActions.map((action) => (
          <li>
            <a
              href={action.href}
              data-track={action.track}
              data-track-location="mobile-menu"
              target={action.icon === 'whatsapp' ? '_blank' : undefined}
              rel={action.icon === 'whatsapp' ? 'noopener noreferrer' : undefined}
              class="flex flex-col items-center gap-2 rounded-2xl bg-slate-50 py-3.5 text-xs font-semibold text-slate-700"
            >
              {action.icon === 'phone' && <Phone size={20} class="text-brand-600" />}
              {action.icon === 'sms' && <MessageSquareText size={20} class="text-brand-600" />}
              {action.icon === 'whatsapp' && <WhatsAppIcon size={20} class="text-[#128c4a]" />}
              {action.icon === 'mail' && <Mail size={20} class="text-brand-600" />}
              {action.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn-primary mt-4 w-full">
        Book a free consultation
      </a>
      <p class="mt-5 text-center text-sm text-slate-500">{formattedAddress}</p>
    </div>
  </div>
</div>
