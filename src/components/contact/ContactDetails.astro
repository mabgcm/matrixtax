---
import { Mail, MapPin, MessageSquareText, Phone } from '@lucide/astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { formattedAddress, site } from '@/config/site';
---

<ul class="space-y-4">
  <li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-900/5">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
      <Phone size={20} />
    </span>
    <div>
      <p class="font-display font-bold text-slate-900">Call us</p>
      <p class="mt-1 flex flex-col">
        <a
          href={site.links.call}
          data-track="call"
          data-track-location="contact-details"
          class="hover:text-brand-700"
        >
          {site.phones.primary.display}
        </a>
        <a
          href={`tel:${site.phones.secondary.e164}`}
          data-track="call"
          data-track-location="contact-details"
          class="hover:text-brand-700"
        >
          {site.phones.secondary.display}
        </a>
      </p>
    </div>
  </li>
  <li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-900/5">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
      <MessageSquareText size={20} />
    </span>
    <div>
      <p class="font-display font-bold text-slate-900">Text or WhatsApp</p>
      <p class="mt-1">Message us to book your consultation.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={site.links.sms}
          data-track="sms"
          data-track-location="contact-details"
          class="btn btn-secondary min-h-10 px-4 text-sm"
        >
          <MessageSquareText size={16} class="text-brand-600" />
          Text
        </a>
        <a
          href={site.links.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
          data-track-location="contact-details"
          class="btn btn-whatsapp min-h-10 px-4 text-sm"
        >
          <WhatsAppIcon size={16} />
          WhatsApp
        </a>
      </div>
    </div>
  </li>
  <li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-900/5">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
      <Mail size={20} />
    </span>
    <div class="min-w-0">
      <p class="font-display font-bold text-slate-900">Email</p>
      <p class="mt-1 flex flex-col">
        <a
          href={`mailto:${site.emails.primary}`}
          data-track="email"
          data-track-location="contact-details"
          class="break-all hover:text-brand-700"
        >
          {site.emails.primary}
        </a>
        <a
          href={`mailto:${site.emails.advisor}`}
          data-track="email"
          data-track-location="contact-details"
          class="break-all hover:text-brand-700"
        >
          {site.emails.advisor}
        </a>
      </p>
    </div>
  </li>
  <li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-slate-900/5">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
      <MapPin size={20} />
    </span>
    <div>
      <p class="font-display font-bold text-slate-900">Visit</p>
      <a
        href={site.links.maps}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 block hover:text-brand-700"
      >
        {formattedAddress}
      </a>
    </div>
  </li>
</ul>
