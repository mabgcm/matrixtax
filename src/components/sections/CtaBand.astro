---
import { ArrowRight, MessageSquareText } from '@lucide/astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Take control of your finances',
  text = `Let ${site.name} be your trusted partner for tax, accounting and business needs. Contact us today for a free consultation.`,
} = Astro.props;
---

<section class="container-page py-6 print:hidden" aria-labelledby="cta-title">
  <div class="relative isolate overflow-hidden rounded-[2rem] bg-brand-900 px-6 py-14 sm:px-12 lg:px-16 lg:py-16">
    <!-- Oversized logo bars as a quiet brand motif -->
    <svg
      aria-hidden="true"
      viewBox="108 33 296 445"
      class="absolute -right-10 -bottom-24 -z-10 h-[30rem] w-auto opacity-[0.12] sm:right-6"
    >
      <g class="fill-brand-300">
        <path d="M112 211 191 263v76l-71 87-8-2z"></path>
        <path d="m216 125 80 51v167l-7 7-73-39z"></path>
        <path d="m320 37 79 52v127l-72 89-7 5z"></path>
      </g>
      <g class="fill-white">
        <path d="m137 473 54-67v67z"></path>
        <path d="m216 376 9-10 71 38v69h-80z"></path>
        <path d="m320 380 79-96v189h-79z"></path>
      </g>
    </svg>
    <div
      aria-hidden="true"
      class="absolute -top-24 -left-24 -z-10 size-80 rounded-full bg-brand-500/40 blur-3xl"
    ></div>

    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 id="cta-title" class="text-3xl text-white sm:text-4xl">
          {title}
        </h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-brand-100">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
        <a href="/contact" class="btn btn-on-dark group">
          Book a consultation
          <ArrowRight size={18} class="transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={site.links.sms}
          data-track="sms"
          data-track-location="cta-band"
          class="btn btn-outline-on-dark md:hidden"
        >
          <MessageSquareText size={18} />
          Text us
        </a>
        <a
          href={site.links.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
          data-track-location="cta-band"
          class="btn btn-outline-on-dark hidden md:inline-flex"
        >
          <WhatsAppIcon size={18} />
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
