---
import { MessageCircleQuestionMark, Phone, Plus } from '@lucide/astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { site } from '@/config/site';
import { faq } from '@/data/faq';
---

<section id="faq" class="section bg-slate-50" aria-labelledby="faq-title">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="section-title">
        Frequently asked questions
      </h2>
      <p class="lead mt-5">Quick answers to the questions we hear most often.</p>

      <div class="card mt-10 p-6 sm:p-7">
        <MessageCircleQuestionMark size={28} class="text-brand-600" />
        <p class="mt-4 font-display text-lg font-bold text-slate-900">Still have questions?</p>
        <p class="mt-1.5">We're happy to help — reach out the way that suits you.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href={site.links.call}
            data-track="call"
            data-track-location="faq"
            class="btn btn-primary min-h-11 px-5"
          >
            <Phone size={18} />
            Call us
          </a>
          <a
            href={site.links.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
            data-track-location="faq"
            class="btn btn-whatsapp min-h-11 px-5"
          >
            <WhatsAppIcon size={18} />
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      {faq.map((item, index) => (
        <details
          class="faq-item group border-b border-slate-200 first:border-t"
          name="faq"
          open={index === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left font-display text-lg font-semibold text-slate-900 transition-colors hover:text-brand-700">
            {item.question}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white text-slate-700 ring-1 ring-slate-200 transition duration-300 group-open:rotate-45 group-open:bg-brand-600 group-open:text-white group-open:ring-brand-600">
              <Plus size={18} />
            </span>
          </summary>
          <p class="pr-12 pb-6 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
