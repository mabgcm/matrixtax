---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import type { Crumb } from '@/lib/seo';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs: Crumb[];
}

const { title, lead, eyebrow, crumbs } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-linear-to-b from-brand-50 to-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-48 right-[-15%] size-[36rem] rounded-full bg-brand-200/50 blur-3xl"></div>
  </div>
  <div class="container-page pt-8 pb-14 sm:pt-12 sm:pb-20">
    <Breadcrumbs crumbs={crumbs} />
    {eyebrow && <p class="eyebrow mt-10">{eyebrow}</p>}
    <h1
      class:list={[
        'max-w-4xl text-4xl leading-[1.1] sm:text-5xl lg:text-6xl',
        eyebrow ? 'mt-4' : 'mt-10',
      ]}
    >
      {title}
    </h1>
    {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
    <slot />
  </div>
</section>
