---
import { Picture } from 'astro:assets';
import { ArrowRight, BadgeCheck, CalendarCheck, Phone } from '@lucide/astro';
import portrait from '@/assets/images/advisor-portrait.png';
import { site } from '@/config/site';

const formatNumber = new Intl.NumberFormat('en-CA');
---

<section class="relative isolate overflow-hidden bg-linear-to-b from-brand-50 via-white to-white">
  <!-- Decorative background: soft glow + faint grid echoing the logo's bars -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 right-[-10%] size-[42rem] rounded-full bg-brand-200/50 blur-3xl"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgb(50_114_185/0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgb(50_114_185/0.06)_1px,transparent_1px)] mask-[radial-gradient(ellipse_at_top,black_30%,transparent_70%)] bg-size-[4rem_4rem]"></div>
  </div>

  <div class="container-page grid items-center gap-14 pt-10 pb-20 sm:pt-16 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-28">
    <div class="lg:col-span-7">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/80 px-3.5 py-1.5 text-sm font-medium text-slate-700 shadow-card ring-1 ring-slate-900/5">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        Tax &amp; accounting in {site.address.city}, {site.address.regionName}
      </p>

      <h1 class="mt-6 text-[2.6rem] leading-[1.06] sm:text-6xl lg:text-[4.25rem]">
        Empowering your <span class="text-brand-600">financial success</span> with expert tax
        solutions
      </h1>

      <p class="lead mt-6 max-w-xl">
        Reliable tax, accounting and business advisory services for individuals, families and small
        businesses — so you can reach your financial goals with confidence and clarity.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn btn-primary group">
          Book a free consultation
          <ArrowRight size={18} class="transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={site.links.call}
          data-track="call"
          data-track-location="hero"
          class="btn btn-secondary"
        >
          <Phone size={18} class="text-brand-600" />
          {site.phones.primary.display}
        </a>
      </div>

      <dl class="mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-slate-200/80 pt-8 sm:gap-8">
        {site.stats.map((stat) => (
          <div class="flex flex-col gap-1">
            <dt class="text-sm leading-snug text-slate-500">{stat.label}</dt>
            <dd class="order-first font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
              {formatNumber.format(stat.value)}
              <span class="text-brand-500">{stat.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-sm sm:max-w-md lg:col-span-5 lg:max-w-none">
      <div
        aria-hidden="true"
        class="absolute -inset-3 rotate-3 rounded-[2.5rem] bg-linear-to-br from-brand-500 to-brand-800 opacity-90"
      ></div>
      <div class="relative overflow-hidden rounded-[2rem] bg-linear-to-b from-slate-100 to-slate-300 shadow-lift ring-1 ring-white/40">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          alt={`${site.advisor.name}, ${site.advisor.title} at ${site.name}`}
          widths={[360, 540]}
          sizes="(min-width: 1024px) 32vw, (min-width: 640px) 28rem, 90vw"
          priority
          class="h-auto w-full"
        />
      </div>

      <div class="card absolute -bottom-7 left-3 flex items-center gap-3 px-4 py-3 sm:-left-8 sm:px-5 sm:py-4">
        <span class="grid size-10 place-items-center rounded-full bg-brand-600 text-white">
          <BadgeCheck size={20} />
        </span>
        <span class="leading-tight">
          <span class="block font-display font-bold text-slate-900">{site.advisor.name}</span>
          <span class="block text-sm text-slate-500">{site.advisor.title}</span>
        </span>
      </div>

      <div class="card absolute top-8 -right-3 hidden items-center gap-2.5 px-4 py-3 sm:flex lg:-right-6">
        <CalendarCheck size={20} class="text-brand-600" />
        <span class="text-sm font-semibold text-slate-800">Free initial consultation</span>
      </div>
    </div>
  </div>
</section>
