---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import PostCard from '@/components/ui/PostCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { getPublishedPosts } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';

const posts = await getPublishedPosts();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];
---

<BaseLayout
  title="Blog — Tax, Accounting & Small Business Guides"
  description="Practical guides on tax, accounting, year-end preparation and growing a small business, from the team at Matrix Tax Solutions."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHeader
    eyebrow="Blog"
    title="Guides & insights"
    lead="Practical articles on tax, accounting and running a small business in Canada. Some articles are published in Turkish."
    crumbs={crumbs}
  />

  <section class="container-page pb-20 sm:pb-24" aria-label="Articles">
    {posts.length === 0 ? (
      <p class="text-lg">New articles are on the way. Check back soon.</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li>
            <PostCard post={post} headingLevel="h2" />
          </li>
        ))}
      </ul>
    )}
  </section>

  <div class="pb-20">
    <CtaBand />
  </div>
</BaseLayout>
