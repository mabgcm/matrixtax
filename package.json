{
  "name": "matrixtax-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matrix Tax Solutions marketing website",
  "engines": {
    "node": "^22.23.4 || ^24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/vercel": "11.0.22",
    "@lucide/astro": "1.81.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-icons": "16.38.1",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.6"
    }
  }
}
